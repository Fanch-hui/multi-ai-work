/src/**/*.[cm][jt]s text eol=lf
/src/**/*.[jt]sx text eol=lf
/apps/**/*.[jt]s text eol=lf
/apps/**/*.[cm][jt]s text eol=lf
/apps/**/*.[jt]sx text eol=lf
/scripts/**/*.[jt]s text eol=lf
/scripts/**/*.[cm][jt]s text eol=lf
/scripts/**/*.[jt]sx text eol=lf
/tests/**/*.[jt]s text eol=lf
/tests/**/*.[cm][jt]s text eol=lf
/tests/**/*.[jt]sx text eol=lf
/*.[jt]s text eol=lf
/*.[cm][jt]s text eol=lf
