{
  "name": "multi-ai-work",
  "version": "0.6.25",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/apps/desktop/main.js",
  "description": "本地 AI 团队工作台",
  "scripts": {
    "dev": "concurrently -k \"tsx src/core/entry.ts --web\" \"vite --host 127.0.0.1\"",
    "dev:core": "tsx src/core/entry.ts --web",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "desktop": "pnpm build && node scripts/package.mjs --desktop",
    "package:mac": "pnpm build && node scripts/package.mjs --mac",
    "package:win": "pnpm build && node scripts/package.mjs --win",
    "verify:providers": "tsx src/verification/providers.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@qodercn-ai/qodercn-agent-sdk": "1.0.51",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "1.2.0",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "docx": "9.9.0",
    "exceljs": "4.4.0",
    "ignore": "7.0.12",
    "jose": "6.2.12",
    "js-yaml": "4.3.2",
    "lucide-react": "1.55.0",
    "mammoth": "1.13.0",
    "openai": "7.32.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "unzipper": "0.12.5",
    "ws": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "build": {
    "appId": "local.multi-ai-work.desktop",
    "productName": "multi-AI work",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/tray*.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "icon": "resources/icon.png",
    "asarUnpack": [
      "**/*.node",
      "node_modules/@vscode/ripgrep*/**/*",
      "node_modules/@qodercn-ai/**/*"
    ],
    "mac": {
      "icon": "resources/icon-mac.icns",
      "identity": "-",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "multi-AI-work-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "multi-AI-work-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.23.0",
    "pnpm": ">=11.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.5",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  }
}
